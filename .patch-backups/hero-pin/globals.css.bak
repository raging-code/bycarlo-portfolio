@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --font-display: "HeroDisplay", var(--font-cooper), 'Cooper Hewitt', system-ui, sans-serif;
  --font-body:    "HeroDisplay", var(--font-cooper), 'Cooper Hewitt', system-ui, sans-serif;

  /* light */
  --bg-primary:   #EBE9E1;
  --text-primary: #2A0E07;
  --text-secondary: #665549;
  --accent:       #D23412;
  --accent-2:     #FFA2B6;
  --border:       rgba(42,14,7,0.14);
  color-scheme: light;
}

html {
  scroll-behavior: smooth;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  margin: 0;
  font-family: var(--font-body);
  font-weight: 400;
  font-size: 16.5px;
  line-height: 1.7;
  overflow-x: hidden;
  background: var(--bg-primary);
  transition: background-color 0.45s ease-in-out;
  -webkit-overflow-scrolling: touch;
}

/* Noise overlay (desktop only) */
@media (min-width: 768px) {
  body::after {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 10000;
    opacity: 0.025;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.5'/%3E%3C/svg%3E");
  }
}

/* Custom cursor (desktop only) */
@media (pointer: fine) {
  * { cursor: none !important; }
}

::selection {
  background: var(--accent);
  color: #FFF4EA;
}

button, a {
  transition: color 0.25s cubic-bezier(0.4, 0, 0.2, 1),
    background-color 0.25s cubic-bezier(0.4, 0, 0.2, 1),
    border-color 0.25s cubic-bezier(0.4, 0, 0.2, 1),
    box-shadow 0.25s cubic-bezier(0.4, 0, 0.2, 1),
    transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
    opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}

/* Sections: promote to their own layer for smoother scrolling */
.theme-section {
  contain: paint;
  -webkit-transform: translateZ(0);
  transform: translateZ(0);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

/* Mobile performance tweaks */
@media (max-width: 767px) {
  .blur-3xl {
    --tw-blur: blur(32px) !important;
    filter: blur(32px) !important;
  }

  .glow-orb {
    will-change: transform;
    -webkit-transform: translate3d(0, 0, 0);
    transform: translate3d(0, 0, 0);
  }

  a, button {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
}

/* Gather navbar – compact, flush at the top, glass capsule after scroll */
/* navbar-static-then-float-patch */
.gnav-wrap {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 50;
  display: flex;
  justify-content: center;
  padding: 0;
  pointer-events: none;
  transition: padding 0.6s cubic-bezier(0.65, 0, 0.2, 1);
}
.gnav-wrap.is-scrolled { padding: 8px 10px 0; }

.gnav {
  pointer-events: auto;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  width: 100%;
  max-width: 100%;
  padding: 12px 20px;
  border-radius: 0;
  color: var(--gn-ink, #2A0E07);
  font-family: var(--font-body), system-ui, sans-serif;
  transition:
    width 0.6s cubic-bezier(0.65, 0, 0.2, 1),
    padding 0.6s cubic-bezier(0.65, 0, 0.2, 1),
    border-radius 0.6s cubic-bezier(0.65, 0, 0.2, 1),
    box-shadow 0.5s;
}
.gnav-wrap.is-scrolled .gnav {
  width: 680px;
  padding: 8px 8px 8px 10px;
  border-radius: 999px;
}
.gnav > *:not(.gnav-glass) { position: relative; z-index: 1; }

/* the global mobile rule gives every a/button a 44px min-height, which would make the bar tall */
.gnav a, .gnav button { min-height: 0; }

/* gnav-glass-surface */
/* liquid glass: drawn by <GlassSurface /> (app/GlassSurface.js). This layer only
   handles position, fade-in on scroll and the corner radius. */
.gnav-glass {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.5s;
}
/* follow the navbar's flat -> pill corner morph instead of a fixed radius */
.gnav-glass .glass-surface {
  border-radius: inherit !important;
}
/* Safari / Firefox fallback */
.gnav-wrap .glass-surface--fallback {
  background: rgba(255, 255, 255, 0.55);
  border: 1px solid rgba(42, 14, 7, 0.14);
  box-shadow:
    inset 0 1px 0 0 rgba(255, 255, 255, 0.6),
    0 8px 24px -8px rgba(0, 0, 0, 0.25);
}
.gnav-wrap.is-scrolled .gnav-glass { opacity: 1; }

.gnav a:focus-visible,
.gnav button:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

/* logo – 1:1 circle */
.gnav-brand {
  position: relative;
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  line-height: 0;
  text-decoration: none;
  transition: width 0.6s cubic-bezier(0.65, 0, 0.2, 1), height 0.6s cubic-bezier(0.65, 0, 0.2, 1), transform 0.3s;
}
.gnav-wrap.is-scrolled .gnav-brand { width: 24px; height: 24px; }
.gnav-brand:hover { transform: scale(1.06); }
/* logo-nudge-right */
.gnav-brand { margin-left: 5px; }
.gnav-logo {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
  user-select: none;
  box-shadow: 0 0 0 1px var(--gn-line, rgba(42, 14, 7, 0.14));
  transition: opacity 0.45s ease-in-out;
}

/* gnav-logo--mark: the Carlo "C" is a wide (241x260), transparent-background SVG,
   not a square photo, so it skips the circular crop/ring built for bcdlogo.png -
   no border-radius, no cover-crop, no hairline box-shadow ring. object-fit:
   contain keeps the whole glyph visible as the brand box resizes on scroll. */
.gnav-logo--mark {
  border-radius: 0;
  object-fit: contain;
  box-shadow: none;
}

.gnav-links {
  display: flex;
  align-items: center;
  gap: 18px;
  min-width: 0;
  transition: gap 0.6s cubic-bezier(0.65, 0, 0.2, 1);
}
.gnav-wrap.is-scrolled .gnav-links { gap: 2px; }

.gnav-link {
  padding: 4px 10px;
  border-radius: 999px;
  font-size: 0.78rem;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
  text-decoration: none;
  color: var(--gn-muted);
  transition: background-color 0.3s;
}
/* navbar-tweaks-v2 */
.gnav-link:hover { color: var(--gn-ink); background: var(--gn-chip); }
.gnav-link.on {
  color: var(--gn-ink);
  border-radius: 0;
  box-shadow: inset 0 -2px 0 var(--gn-accent);
}
.gnav-wrap.is-scrolled .gnav-link.on {
  border-radius: 999px;
  box-shadow: none;
  background: var(--gn-chip);
}

.gnav-end {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

.gnav-cta {
  padding: 7px 14px;
  border-radius: 999px;
  border: 1px solid var(--gn-ink);
  font-size: 0.78rem;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
  text-decoration: none;
  color: var(--gn-ink);
  transition: background-color 0.4s, color 0.4s;
}
.gnav-wrap.is-scrolled .gnav-cta {
  background: var(--gn-ink);
  color: var(--gn-cta-fg);
}

/* mobile – everything stays visible: logo, all links, Contact and the switch */
@media (max-width: 640px) {
  .gnav-wrap.is-scrolled { padding: 6px 8px 0; }
  /* navbar-mobile-bigger */
  .gnav { padding: 12px 10px; gap: 4px; }
  .gnav-wrap.is-scrolled .gnav { width: 100%; padding: 8px 10px 8px 8px; }

  .gnav-brand, .gnav-wrap.is-scrolled .gnav-brand { width: 27px; height: 27px; }

  .gnav-links,
  .gnav-wrap.is-scrolled .gnav-links {
    flex: 1;
    justify-content: center;
    gap: 0;
    overflow-x: auto;          /* safety net on very narrow phones */
    scrollbar-width: none;
  }
  .gnav-links::-webkit-scrollbar { display: none; }

  /* one size knob: font scales with the screen width */
  .gnav-link, .gnav-cta { font-size: clamp(9.5px, 2.8vw, 14px); }
  .gnav-link { padding: 7px 0.45em; }
  .gnav-cta  { padding: 9px 0.55em; }

  .gnav-end { gap: 6px; }
}
@media (max-width: 380px) {
  .gnav-link { padding: 7px 0.36em; }
  .gnav-cta  { padding: 9px 0.45em; }
  .gnav-end  { gap: 4px; }
}

@media (prefers-reduced-motion: reduce) {
  .gnav-wrap, .gnav, .gnav-glass, .gnav-links, .gnav-link, .gnav-cta, .gnav-logo,
  .gnav-brand, body { transition: none; }
}

.logo-gradient {
  color: #D23412;
}

.glow-bar-track {
  position: relative;
}

.nav-links-scroll {
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.nav-links-scroll::-webkit-scrollbar {
  display: none;
}

/* techstack-deck:css:start */
/* Tech stack: fanned card deck on a red band (cards straddle the red and the cream below). */
.tsd-sec {
  --tsd-bg: #EBE9E1;
  --tsd-on: #FFF4EA;
  --tsd-text: #2A0E07;
  --tsd-accent: #D23412;
  --tsd-card-1: #8A230B; /* lit corner */
  --tsd-card-2: #561508; /* base */
  --tsd-card-3: #2E0A04; /* shaded corner */
  --tsd-pad: clamp(24px, 5.5vw, 80px);
  --tsd-top-pad: clamp(24px, 3vw, 48px); /* space above the heading: Services (red) sits right above, so this stays small */
  --tsd-s: 1; /* overall deck scale, raised on bigger screens below (the page reads it too) */
  --tsd-stage-h: 460px;
  --tsd-card-h: 340px; /* techstack-closer: same as the .tsd-card height at this breakpoint */
  --tsd-gap: clamp(20px, 3vw, 40px); /* techstack-closer: space between the heading and the top of the front card (smaller = closer) */
  position: relative;
  overflow: hidden; /* the fanned cards can poke past the screen edge: no sideways scroll */
  background: var(--tsd-bg);
  color: var(--tsd-text);
  padding-bottom: clamp(72px, 9vw, 140px);
}
@media (max-width: 480px) {
  .tsd-sec { --tsd-stage-h: 420px; --tsd-card-h: 300px; }
}
@media (min-width: 768px) {
  .tsd-sec { --tsd-s: 1.1; --tsd-stage-h: calc(460px * var(--tsd-s)); --tsd-card-h: calc(340px * var(--tsd-s)); }
}
@media (min-width: 1100px) {
  .tsd-sec { --tsd-s: 1.25; }
}

.tsd-top {
  background: var(--tsd-accent);
  color: var(--tsd-on);
  text-align: center;
  padding: var(--tsd-top-pad) var(--tsd-pad) calc(var(--tsd-card-h) * 0.5 + var(--tsd-gap)); /* techstack-closer */
}
.tsd-top ::selection { background: var(--tsd-bg); color: var(--tsd-accent); }
.tsd-title {
  margin: 0 auto;
  max-width: 15ch;
  font-family: var(--font-display);
  font-weight: 800;
  font-size: clamp(2.9rem, 9.2vw, 9.4rem);
  line-height: 0.9;
  letter-spacing: -0.03em;
  word-spacing: 0.07em;
  text-wrap: balance;
}
.tsd-title .ink { color: var(--tsd-text); }
@media (max-width: 820px) {
  .tsd-title { max-width: 11ch; }
}

.tsd-deck {
  position: relative;
  z-index: 2;
  margin-top: calc(var(--tsd-stage-h) * -0.5);
}
.tsd-stage {
  position: relative;
  width: 100%;
  height: var(--tsd-stage-h);
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  touch-action: pan-y; /* sideways drag = swipe the deck, vertical = page scroll */
  -webkit-tap-highlight-color: transparent;
}
.tsd-stage:focus { outline: none; }
.tsd-stage:focus-visible { outline: 2px solid var(--tsd-text); outline-offset: -6px; border-radius: 28px; }

/* tsd-no-tap-outline */
/* :focus-visible alone isn't reliable on touch: some mobile browsers still
   treat a tap as "visible" focus, which drew a square ring around the front
   card. .tsd-no-ring is toggled from JS: on while idle / after a tap, off the
   moment real keyboard (Tab/arrow) navigation happens. */
.tsd-stage.tsd-no-ring:focus-visible { outline: none; }

.tsd-card {
  position: absolute;
  width: 252px;
  height: 340px;
  border-radius: 22px;
  background:
    radial-gradient(120% 70% at 18% 0%, rgba(255, 255, 255, 0.10), rgba(255, 255, 255, 0) 60%),
    linear-gradient(165deg, var(--tsd-card-1) 0%, var(--tsd-card-2) 48%, var(--tsd-card-3) 100%);
  border: 1px solid rgba(255, 244, 234, 0.14);
  padding: 28px 26px 26px;
  display: flex;
  flex-direction: column;
  cursor: grab;
  will-change: transform;
  transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.6s ease;
  user-select: none;
  -webkit-user-select: none;
  overflow: hidden;
}
.tsd-card:active { cursor: grabbing; }
.tsd-card.dragging { transition: none; }
/* darkens the cards behind the front one; sits above the card background, below the content */
.tsd-card::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  border-radius: inherit;
  background: #000;
  opacity: var(--shade, 0);
  transition: opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  pointer-events: none;
}
.tsd-card.front {
  border-color: rgba(255, 244, 234, 0.22);
  box-shadow:
    0 0 0 1px rgba(0, 0, 0, 0.55),
    0 40px 70px -22px rgba(42, 14, 7, 0.55),
    0 12px 24px -4px rgba(0, 0, 0, 0.4);
}
.tsd-card.side {
  box-shadow:
    0 0 0 1px rgba(0, 0, 0, 0.5),
    0 16px 28px -8px rgba(0, 0, 0, 0.5);
}
/* collapsed: no shadow, so nothing peeks out from behind the front card */
.tsd-stage.collapsed .tsd-card.side { box-shadow: none; }

.tsd-card-rule {
  position: absolute;
  inset: 0;
  border-radius: 22px;
  pointer-events: none;
  box-shadow:
    inset 0 1px 0 0 rgba(255, 255, 255, 0.30),
    inset 0 0 0 1px rgba(255, 255, 255, 0.09),
    inset 0 -2px 0 0 rgba(0, 0, 0, 0.40);
}
.tsd-card-title {
  margin: 0 0 24px;
  text-align: center;
  font-family: var(--font-display);
  font-weight: 800;
  font-size: 30px;
  letter-spacing: 0.01em;
  line-height: 1;
  color: var(--tsd-on);
}
.tsd-icons {
  --tsd-tool-w: 60px;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-content: flex-start;
  gap: 20px 8px;
  width: 100%;
  margin: 0 auto;
}
.tsd-icons.two-col { max-width: calc(var(--tsd-tool-w) * 2 + 20px); }
.tsd-tool {
  width: var(--tsd-tool-w);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}
.tsd-tool-icon {
  width: 34px;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.tsd-tool-icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  pointer-events: none;
  -webkit-user-drag: none;
}
.tsd-tool-name {
  font-family: var(--font-body);
  font-size: 10.5px;
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: 0.01em;
  text-align: center;
  color: rgba(255, 244, 234, 0.78);
}

@media (max-width: 480px) {
  .tsd-card { width: 218px; height: 300px; padding: 24px 20px 22px; }
  .tsd-card-title { font-size: 25px; margin: 0 0 20px; }
  .tsd-tool-icon { width: 30px; height: 30px; }
  .tsd-icons { gap: 18px 6px; --tsd-tool-w: 54px; }
}
/* desktop: wider cards, scaled up with --tsd-s */
@media (min-width: 768px) {
  .tsd-card {
    width: calc(320px * var(--tsd-s));
    height: calc(340px * var(--tsd-s));
    border-radius: calc(22px * var(--tsd-s));
    padding: calc(28px * var(--tsd-s)) calc(26px * var(--tsd-s)) calc(26px * var(--tsd-s));
  }
  .tsd-card-rule { border-radius: calc(22px * var(--tsd-s)); }
  .tsd-card-title { font-size: calc(34px * var(--tsd-s)); margin: 0 0 calc(24px * var(--tsd-s)); }
  .tsd-icons { --tsd-tool-w: calc(80px * var(--tsd-s)); gap: calc(20px * var(--tsd-s)) calc(8px * var(--tsd-s)); }
  .tsd-tool { gap: calc(8px * var(--tsd-s)); }
  .tsd-tool-icon { width: calc(38px * var(--tsd-s)); height: calc(38px * var(--tsd-s)); }
  .tsd-tool-name { font-size: calc(11.5px * var(--tsd-s)); }
}
@media (prefers-reduced-motion: reduce) {
  .tsd-card, .tsd-card::before { transition: none; }
}
/* techstack-deck:css:end */

/* navbar-glass-v4: exact "Glass" capsule (design 1) ───────────────────────── */

.gnav-wrap {
  --ng-tx: #2A0E07;
  --ng-bg: #EBE9E1;
  --ng-mu: rgba(42, 14, 7, 0.58);
  --ng-chip: rgba(42, 14, 7, 0.06);
  --ng-gl: rgba(240, 238, 231, 0.6);
  --ng-edge: rgba(42, 14, 7, 0.1);
  --ng-hi: rgba(255, 255, 255, 0.9);
  --ng-shadow: rgba(42, 14, 7, 0.14);
}

/* floating, centered, always a capsule */
.gnav-wrap.is-scrolled { padding: 16px 12px 0; }

/* navbar-responsive-minwidth-patch */
/* navbar-center-links-patch */
.gnav-wrap.is-scrolled .gnav {
  width: auto;
  min-width: min(760px, calc(100vw - 24px));
  max-width: 100%;
  justify-content: space-between;
  gap: 2px;
  padding: 5px 5px 5px 7px;
  border-radius: 999px;
  color: var(--ng-tx);
  background: var(--ng-gl);
  border: 1px solid var(--ng-edge);
  -webkit-backdrop-filter: blur(18px) saturate(1.5);
  backdrop-filter: blur(18px) saturate(1.5);
  box-shadow:
    inset 0 1px 0 var(--ng-hi),
    0 14px 40px var(--ng-shadow);
  transition: background-color 0.4s, border-color 0.4s, box-shadow 0.4s;
}

/* the capsule is plain CSS glass now, so the SVG liquid-glass layer is not needed */
.gnav-wrap.is-scrolled .gnav-glass { display: none; }

/* logo: same size as the static bar's scrolled state — only the hairline ring color is themed */
.gnav-wrap.is-scrolled .gnav-logo { box-shadow: 0 0 0 1px var(--ng-edge); }

/* gnav-logo--mark: no ring in the scrolled/themed state either - see note above */
.gnav-wrap.is-scrolled .gnav-logo--mark { box-shadow: none; }

/* links: same layout/sizing as the static bar's scrolled state — only colors are themed */
.gnav-wrap.is-scrolled .gnav-link {
  color: var(--ng-mu);
}
.gnav-wrap.is-scrolled .gnav-link:hover {
  color: var(--ng-tx);
  background: var(--ng-chip);
}
.gnav-wrap.is-scrolled .gnav-link.on {
  color: var(--ng-tx);
  background: var(--ng-chip);
}

/* Contact CTA: same layout/sizing as the static bar's scrolled state — only recolored */
.gnav-wrap.is-scrolled .gnav-cta {
  background: var(--ng-tx);
  color: var(--ng-bg);
}
.gnav-wrap.is-scrolled .gnav-cta:hover { opacity: 0.88; }

/* phones: same capsule design, but same layout/sizing as the static bar's own
   mobile rules (see the un-themed @media (max-width: 640px) block above) */
@media (max-width: 640px) {
  .gnav-wrap.is-scrolled { padding: 6px 8px 0; }
  .gnav-wrap.is-scrolled .gnav { width: 100%; min-width: 0; }
}
/* end navbar-glass-v4 */
/* navbar-static-layout-floating-design-patch */

/* navbar-spring-morph-patch */
/* Spring morph: full-width bar -> floating capsule with a small bounce.
   Tweak --gn-spring (more overshoot = bigger 2nd number) and --gn-spring-dur. */
.gnav-wrap {
  --gn-spring: cubic-bezier(0.34, 1.45, 0.5, 1);
  --gn-spring-dur: 0.85s;
}

/* bar -> capsule: this is the rule the browser uses while scrolling DOWN,
   because a transition always follows the destination state's rule. */
.gnav-wrap.is-scrolled {
  padding: 16px 12px 0;
  transition: padding var(--gn-spring-dur) var(--gn-spring);
}
.gnav-wrap.is-scrolled .gnav {
  /* explicit width (was auto) so it can animate; max-width: 100% keeps it
     inside the viewport on narrow screens */
  width: 760px;
  min-width: 0;
  transition:
    width var(--gn-spring-dur) var(--gn-spring),
    padding var(--gn-spring-dur) var(--gn-spring),
    border-radius 0.5s ease-out,
    background-color 0.4s,
    border-color 0.4s,
    box-shadow 0.6s ease-out;
}

/* capsule -> bar (scrolling back to the top) keeps the existing calm
   ease from the base .gnav-wrap / .gnav rules: no overshoot, so the bar
   never pokes past the screen edges. */

/* phones: same layout as before (full width), only the spring on the gap */
@media (max-width: 640px) {
  .gnav-wrap.is-scrolled { padding: 6px 8px 0; }
  .gnav-wrap.is-scrolled .gnav { width: 100%; min-width: 0; }
}

@media (prefers-reduced-motion: reduce) {
  .gnav-wrap.is-scrolled,
  .gnav-wrap.is-scrolled .gnav { transition: none; }
}
/* end navbar-spring-morph-patch */

/* about-hero:start */
.ip-section { position: relative; overflow: hidden; }
.ip-stage { container-type: inline-size; width: 100%; }
.ip-about {
  display: flex; align-items: center; justify-content: center; gap: 1.4cqw;
  padding: 4cqw 2cqw;
}
.ip-visual { position: relative; flex: none; width: 31cqw; aspect-ratio: 1; margin: 0 4cqw 0 4cqw; }
.ip-ring { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); border-radius: 50%; aspect-ratio: 1; }
.ip-r0 { width: 100%; border: 1.5px solid var(--accent);
  background: radial-gradient(circle at 32% 48%, #DFDCD0 0%, #E5E2D7 45%, #EBE9E1 100%); }
.ip-outer {
  position: absolute; left: 50%; top: 50%; width: 150%; aspect-ratio: 1;
  transform: translate(-50%, -50%); pointer-events: none;
  -webkit-mask-image: linear-gradient(to right, #000 62%, transparent 84%);
          mask-image: linear-gradient(to right, #000 62%, transparent 84%);
}
.ip-r1 { width: 77.6%; border: 1.2px solid rgba(255, 162, 182, 0.65); }
.ip-r2 { width: 88.7%; border: 1.2px solid rgba(210, 52, 18, 0.38); }
.ip-r3 { width: 100%;  border: 1px solid rgba(210, 52, 18, 0.14); }
/* me.png is 1086x1448 with transparent padding; the figure itself occupies
   x 405-1064, y 424-1448. The wrapper is the figure's box and the image is
   offset inside it, so no re-cropping of the file is needed. */
.ip-me {
  position: absolute; left: 29%; top: 2%; width: 62.5%;
  aspect-ratio: 659 / 1024; overflow: hidden;
  -webkit-mask-image: linear-gradient(to bottom, #000 74%, transparent 100%);
          mask-image: linear-gradient(to bottom, #000 74%, transparent 100%);
}
.ip-me img {
  position: absolute; left: -61.46%; top: -41.41%;
  width: 164.8%; max-width: none; height: auto; display: block;
  user-select: none; -webkit-user-drag: none;
}
.ip-text { max-width: 36cqw; position: relative; z-index: 1; }
.ip-title {
  margin: 0; font-family: var(--font-display); font-weight: 800;
  font-size: clamp(44px, 5.7cqw, 112px); line-height: 0.92; letter-spacing: -0.02em;
  color: var(--text-primary);
}
.ip-dot { color: var(--accent); }
.ip-copy {
  margin: 1.8cqw 0 0; font-family: var(--font-body); font-weight: 400;
  font-size: clamp(15px, 1.25cqw, 24px); line-height: 1.63; color: var(--text-secondary);
}
/* Phones: photo on top, text below */
@container (max-width: 767px) {
  .ip-about { flex-direction: column; align-items: flex-start; padding: 32px 24px 40px; gap: 24px; }
  .ip-visual { width: 52cqw; max-width: 225px; margin: 12px 0 0; align-self: center; }
  .ip-outer { -webkit-mask-image: none; mask-image: none; }
  .ip-text { max-width: 100%; }
  .ip-title { font-size: 48px; }
  .ip-copy { font-size: 15px; margin-top: 16px; }
}
/* about-hero:end */

/* about-brush:start */
/* About section is pinned while the brush paints */
.ip-track { position: relative; height: 430vh; height: 430svh; }
.ip-pin { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; }
.ip-pin .ip-section { min-height: 100%; display: flex; align-items: center; }
.ip-pin .ip-stage { width: 100%; }
.ip-brush {
  position: absolute; inset: 0; width: 100%; height: 100%;
  pointer-events: none; z-index: 5;
}
/* about-brush:end */

/* perf-patch:start */
/* Brush canvas: no full-screen CSS filter on every frame; isolate it on its own layer. */
.ip-brush { filter: none; contain: strict; transform: translateZ(0); }

/* Sections used to force a GPU layer each (will-change + translateZ + backface-visibility):
   eight full-width layers cost memory and slow compositing, especially on phones.
   contain: paint (from the base rule) still isolates them; delete this block to restore. */
.theme-section {
  will-change: auto;
  -webkit-transform: none;
  transform: none;
  backface-visibility: visible;
  -webkit-backface-visibility: visible;
}
html, body { will-change: auto; }
/* perf-patch:end */

/* brush-viewport:start */
/* The brush must cover the LARGE viewport (URL bar hidden) so no strip is left at the
   bottom on phones. Content stays centered in the SMALL viewport (URL bar shown). */
:root { --ab-svh: 100vh; --ab-lvh: 100vh; }
@supports (height: 100lvh) {
  :root { --ab-svh: 100svh; --ab-lvh: 100lvh; }
}
/* same scroll length as before: 4.3 x small viewport, plus the extra the taller pin adds */
.ip-track { height: calc(var(--ab-svh) * 4.3 + (var(--ab-lvh) - var(--ab-svh))); }
.ip-pin { height: var(--ab-lvh); }
.ip-pin .ip-section { min-height: var(--ab-svh); }
/* brush-viewport:end */

/* smooth-scroll:start */
/* JS smoothing replaces CSS smooth scrolling (the two fight each other) */
html { scroll-behavior: auto; }
/* smooth-scroll:end */

/* projects-red:css:start */
/* "Selected projects" continues the red the About brush ends on (same as AB_COLOR) */
#work { background-color: #D23412; }
#work ::selection { background: #FFF4EA; color: #D23412; }
/* projects-red:css:end */

/* about-gap:start */
/* Phones: About content sits low on the pinned screen (bottom-anchored), so less empty
   space is left between the paragraph and the Selected projects section. */
@media (max-width: 767px) {
  .ip-pin .ip-section { align-items: flex-end; }
  .ip-pin .ip-about { padding-bottom: 28px; }
}
/* about-gap:end */

/* services:css:start */
/* services-accordion: premium accordion on the site red (#D23412) with cream (#FFF4EA). */
.svc-section {
  --svc-pull: 100px; /* tucks Services up toward Projects: bigger = closer, 0 = no overlap */
  position: relative;
  margin-top: calc(var(--svc-pull) * -1);
  background: #D23412;
  color: #FFF4EA;
  /* extra top space keeps the heading clear of the floating navbar and the overlap above */
  padding: calc(var(--svc-pull) + clamp(72px, 10vw, 140px)) clamp(20px, 5vw, 64px) clamp(72px, 10vw, 140px);
}
.svc-section ::selection { background: #FFF4EA; color: #D23412; }
.svc-wrap { max-width: 1180px; margin: 0 auto; }

.svc-heading {
  margin: 0 0 clamp(40px, 6vw, 80px);
  text-align: center;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: clamp(52px, 12.5vw, 176px);
  line-height: 0.88;
  letter-spacing: -0.03em;
}

.svc-list { list-style: none; margin: 0; padding: 0; }
.svc-row { border-top: 1px solid rgba(255, 244, 234, 0.34); }
.svc-row:last-child { border-bottom: 1px solid rgba(255, 244, 234, 0.34); }
.svc-head { margin: 0; font: inherit; }

.svc-trigger {
  all: unset;
  box-sizing: border-box;
  width: 100%;
  display: flex;
  align-items: center;
  gap: 16px;
  padding: clamp(20px, 2.6vw, 34px) 0;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}
.svc-trigger:focus-visible { outline: 2px solid #FFF4EA; outline-offset: 4px; border-radius: 8px; }

.svc-title {
  flex: 1;
  text-align: left;
  font-family: var(--font-display);
  font-weight: 600;
  font-size: clamp(24px, 4.2vw, 56px);
  line-height: 1.05;
  letter-spacing: -0.02em;
  text-wrap: balance;
  transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
}
@media (hover: hover) {
  .svc-trigger:hover .svc-title { transform: translateX(10px); }
  .svc-trigger:hover .svc-icon { border-color: #FFF4EA; }
}

/* plus / minus circle */
.svc-icon {
  flex: none;
  position: relative;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: 1px solid rgba(255, 244, 234, 0.5);
  transition: background 0.35s, color 0.35s, border-color 0.35s, transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
}
.svc-icon::before,
.svc-icon::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 14px;
  height: 1.5px;
  background: currentColor;
  transform: translate(-50%, -50%);
}
.svc-icon::after {
  transform: translate(-50%, -50%) rotate(90deg);
  transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
}
.svc-row.is-open .svc-icon {
  background: #FFF4EA;
  color: #D23412;
  border-color: #FFF4EA;
  transform: rotate(180deg);
}
.svc-row.is-open .svc-icon::after { transform: translate(-50%, -50%) rotate(0deg); }

/* smooth height animation without measuring */
.svc-panel {
  display: grid;
  grid-template-rows: 0fr;
  transition: grid-template-rows 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
}
.svc-row.is-open .svc-panel { grid-template-rows: 1fr; }
.svc-panel-inner { overflow: hidden; }
.svc-text {
  margin: 0;
  max-width: 62ch;
  padding: 0 60px clamp(24px, 3vw, 40px) 0;
  font-family: var(--font-body);
  font-weight: 400;
  font-size: clamp(15px, 1.3vw, 18px);
  line-height: 1.7;
  opacity: 0.9;
}

@media (max-width: 600px) {
  .svc-icon { width: 38px; height: 38px; }
  .svc-trigger { gap: 12px; }
  .svc-text { padding-right: 0; }
}
@media (prefers-reduced-motion: reduce) {
  .svc-title, .svc-icon, .svc-icon::after, .svc-panel { transition: none; }
}
/* services:css:end */

/* contact-threads:start */
/* Contact heading: as large as fits on one line on phones, original size on desktop */
.contact-h2 { font-size: min(4.5rem, calc((100vw - 3rem) * 0.154)); }
@media (min-width: 768px) {
  .contact-h2 { font-size: clamp(2.4rem, 9vw, 5.5rem); }
}
/* contact-threads:end */

/* cooper-hewitt:start */
/* ALL CAPS: intro title ("Hi, I'm Carlo."), Tech Stack heading and category titles */
.ip-title,
.tsd-title,
.tsd-card-title { text-transform: uppercase; }
/* cooper-hewitt:end */
/* cooper-hewitt:applied */

/* hero-v2:applied */

/* hero-red:start */
@font-face {
  font-family: "HeroDisplay";
  font-style: normal;
  font-weight: 100 900;
  font-stretch: 62% 125%;
  font-display: swap;
  src: url("./fonts/ArchivoVF.woff2") format("woff2");
}
:root { --font-hero: "HeroDisplay", 'Cooper Hewitt', system-ui, sans-serif; }

/* red frame around a cream, rounded window */
.hf-frame {
  --hf-pad: clamp(12px, 1.8vw, 26px);
  --hf-r: clamp(20px, 2.6vw, 36px);
  background: #D23412;
  padding: var(--hf-pad);
}
.hf-hero {
  position: relative;
  min-height: calc(100svh - 2 * var(--hf-pad));
  overflow: hidden;
  display: flex;
  align-items: center;
  border-radius: var(--hf-r);
  padding: 88px clamp(20px, 4.4vw, 64px) 120px;
  background: #EBE9E1;
  color: #2A0E07;
}
.hf-grid { width: 100%; display: grid; grid-template-columns: minmax(0, 1fr); align-items: center; }
.hf-col { min-width: 0; }

.hf-title {
  margin: 0;
  text-align: center;
  font-family: var(--font-hero);
  font-weight: 600;
  font-stretch: 112%;
  text-transform: uppercase;
  letter-spacing: -0.04em;
  line-height: 1;
  white-space: nowrap;
  color: #2A0E07;
}
.hf-l { display: block; overflow: hidden; padding-bottom: 0.04em; }
.hf-l > span { display: inline-block; transform: translateY(110%); }
.hf-go .hf-l > span { animation: hf-up 1s cubic-bezier(.22, 1, .36, 1) forwards; }
.hf-go .hf-l:nth-child(2) > span { animation-delay: .1s; }
.hf-go .hf-l:nth-child(3) > span { animation-delay: .2s; }
.hf-fw { color: #D23412; }
.hf-hl { display: inline-block; padding: 0 .05em; padding-top: .05em; line-height: .86; margin-left: -.05em; }

/* services rotator: one dark row, the others light */
.hf-rot {
  position: absolute;
  right: clamp(20px, 4.4vw, 64px);
  bottom: clamp(24px, 5svh, 56px);
  text-align: right;
  font-family: var(--font-hero);
  font-stretch: 112%;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: -0.035em;
  font-size: clamp(1rem, 2.5vw, 2.4rem);
  line-height: 1.3;
  height: 3.9em;
  overflow: hidden;
  opacity: 0;
}
.hf-go .hf-rot { animation: hf-in .8s ease .9s forwards; }
.hf-rot ul { list-style: none; margin: 0; padding: 0; transition: transform .8s cubic-bezier(.65, 0, .2, 1); }
.hf-rot li { height: 1.3em; white-space: nowrap; color: rgba(42, 14, 7, .2); transition: color .6s; }
.hf-rot li.on { color: #2A0E07; }

@keyframes hf-up { to { transform: none; } }
@keyframes hf-in { to { opacity: 1; transform: none; } }
@media (max-width: 760px) {
  .hf-hero { align-items: center; padding-top: 88px; }
  .hf-rot { font-size: clamp(.8rem, 3.6vw, 1.2rem); }
}
@media (prefers-reduced-motion: reduce) {
  .hf-l > span { animation: none !important; transform: none; }
  .hf-rot { animation: none !important; opacity: 1; transform: none; }
  .hf-rot ul { transition: none; }
}

/* the fixed navbar sits inside the cream window while at the top of the page */
.gnav-wrap:not(.is-scrolled) .gnav {
  padding: calc(clamp(12px, 1.8vw, 26px) + 18px) calc(clamp(12px, 1.8vw, 26px) + 26px);
}
@media (max-width: 640px) {
  .gnav-wrap:not(.is-scrolled) .gnav {
    padding: calc(clamp(12px, 1.8vw, 26px) + 14px) calc(clamp(12px, 1.8vw, 26px) + 14px);
  }
}
/* hero-red:end */
/* hero-red:applied */
/* font-sitewide:applied */
